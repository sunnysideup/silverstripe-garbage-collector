{
  "name": "sunnysideup/silverstripe-garbage-collector",
  "description": "SilverStripe Garbage Collector module",
  "keywords": [
    "silverstripe",
    "garbage",
    "collector",
    "versions",
    "versioning",
    "pruning",
    "pruner",
    "obsolete",
    "database",
    "stale"
  ],
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "SilverStripe\\GarbageCollector\\": "src/",
      "SilverStripe\\GarbageCollector\\Tests\\": "tests/php/"
    }
  },
  "authors": [
    {
      "name": "Brett Tasker",
      "email": "brett.tasker@gmail.com"
    }
  ],
  "require": {
    "silverstripe/framework": "^6.0"
  },
  "require-dev": {
  },
  "suggest": {
    "symbiote/silverstripe-queuedjobs": "For usage of the GarbageCollectorJob within your application"
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "silverstripe/vendor-plugin": true
    }
  }
}
